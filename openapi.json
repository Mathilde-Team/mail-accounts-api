{
  "openapi": "3.1.0",
  "info": {
    "title": "Mail Accounts API",
    "description": "Gestion docker-mailserver : list, add, adds, modify et delete. Toutes les routes /accounts exigent une cle Bearer. Seuls les mots de passe generes sont renvoyes, une seule fois a la creation. Les hashes ne sont jamais exposes. DELETE ne supprime pas les boites sur disque.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Verifier le processus API",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Lister les comptes (list)",
        "operationId": "list_accounts_accounts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountList"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Ajouter un compte (add)",
        "operationId": "add_account_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedAccount"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "409": {
            "description": "Compte deja existant."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/accounts/batch": {
      "post": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Ajouter un lot de comptes (transaction atomique)",
        "operationId": "add_accounts_accounts_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchAccounts"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CreatedAccount"
                  },
                  "type": "array",
                  "title": "Response Add Accounts Accounts Batch Post"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "409": {
            "description": "Doublon dans le lot ou compte existant ; aucun ajout."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/accounts/numbered": {
      "post": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Ajouter des comptes numerotes (adds)",
        "description": "Equivalent de manage_accounts.py adds EMAIL PASSWORD START END. Pour user@example.org, start=1 et end=4 : user1, user2 et user3. Le mot de passe fourni est partage ; si omis, chaque compte recoit un mot de passe aleatoire distinct. Lot atomique de 1 a 100 comptes.",
        "operationId": "add_numbered_accounts_accounts_numbered_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NumberedAccounts"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CreatedAccount"
                  },
                  "type": "array",
                  "title": "Response Add Numbered Accounts Accounts Numbered Post"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "409": {
            "description": "Un compte existe deja ; aucun ajout."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/accounts/{email}": {
      "get": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Lire un compte sans son hash",
        "operationId": "get_account_accounts__email__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "404": {
            "description": "Compte absent."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Modifier le mot de passe (modify)",
        "operationId": "modify_account_accounts__email__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "404": {
            "description": "Compte absent."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Comptes mail"
        ],
        "summary": "Supprimer un compte (delete)",
        "description": "Suppression sans confirmation interactive. Les donnees de la boite restent sur disque.",
        "operationId": "delete_account_accounts__email__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Cle Bearer absente ou incorrecte."
          },
          "503": {
            "description": "Fichier de comptes absent, malforme ou inaccessible."
          },
          "404": {
            "description": "Compte absent."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "folder": {
            "type": "string",
            "title": "Folder"
          }
        },
        "type": "object",
        "required": [
          "email",
          "folder"
        ],
        "title": "Account"
      },
      "AccountList": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "type": "array",
            "title": "Accounts"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "accounts",
          "total"
        ],
        "title": "AccountList"
      },
      "BatchAccounts": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/CreateAccount"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Accounts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accounts"
        ],
        "title": "BatchAccounts"
      },
      "ChangePassword": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "description": "Nouveau mot de passe, jamais renvoye dans la reponse.",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "ChangePassword"
      },
      "CreateAccount": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_+%-]+(?:\\.[A-Za-z0-9_+%-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$",
            "title": "Email",
            "description": "Adresse du compte.",
            "examples": [
              "user@example.org"
            ]
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Omis ou null : generation automatique ; sinon mot de passe fourni."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "CreateAccount"
      },
      "CreatedAccount": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "folder": {
            "type": "string",
            "title": "Folder"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "folder"
        ],
        "title": "CreatedAccount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NumberedAccounts": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_+%-]+(?:\\.[A-Za-z0-9_+%-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$",
            "title": "Email",
            "description": "Adresse du compte.",
            "examples": [
              "user@example.org"
            ]
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Omis ou null : generation automatique ; sinon mot de passe fourni."
          },
          "start": {
            "type": "integer",
            "title": "Start",
            "description": "Premier suffixe numerique inclus.",
            "examples": [
              1
            ]
          },
          "end": {
            "type": "integer",
            "title": "End",
            "description": "Dernier suffixe numerique exclu, comme range().",
            "examples": [
              4
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "start",
          "end"
        ],
        "title": "NumberedAccounts"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
